# The user the files are written as. Leave at 0 to write as root; on a NAS
# set your own, `id <user>` gives the pair.
PUID=0
PGID=0

# Copy this file to .env and adjust the paths.

# Interface and message language: en or fr.
GORDI_LANG=en

# The folder to sort through.
GORDI_INPUT=./media/inbox

# Where the tidy library goes.
GORDI_OUTPUT=./media/library

# move = move the files | copy = copy them and keep the original
GORDI_MODE=move

# Port of the web interface
GORDI_PORT=7373

# How often to scan automatically, in seconds
GORDI_SCAN_EVERY=60

# MusicBrainz insists on knowing who is using their API: put a URL or your
# email address. Without it they may block requests.
GORDI_CONTACT=https://github.com/gordi-app/gordi

# Prefetching MusicBrainz suggestions in the background, in seconds between two
# albums. 0 turns it off.
GORDI_PREFETCH_EVERY=3

# The library tree: one pattern per case.
# Fields: {artist} {album} {year} {track} {title} {disc} {format}
# Translated field names work too; the settings page lists them.
GORDI_PATTERN={artist}/{album} ({year})/{track} - {title}
GORDI_PATTERN_MULTI={artist}/{album} ({year})/CD{disc:0}/{track} - {title}
